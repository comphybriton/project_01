<section class="again-free-from">
  <img
    class="again-free-from__watermark"
    src="{{ 'again-white-symbol.svg' | asset_url }}"
    alt=""
    aria-hidden="true"
    width="420"
    height="407"
    loading="lazy"
  >

  <div class="page-width again-free-from__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="again-free-from__eyebrow">
        {{ section.settings.eyebrow | escape }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="again-free-from__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <ul class="again-free-from__list" role="list">
      {% for block in section.blocks %}
        {% if block.settings.label != blank %}
          <li class="again-free-from__item" {{ block.shopify_attributes }}>
            {{ block.settings.label | escape }}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "AGAIN free from",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Free from"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What you won't find."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Free-from item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "No bicarb"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "AGAIN free from",
      "blocks": [
        { "type": "item", "settings": { "label": "No bicarb" } },
        { "type": "item", "settings": { "label": "No aluminium" } },
        { "type": "item", "settings": { "label": "No parabens" } }
      ]
    }
  ]
}
{% endschema %}
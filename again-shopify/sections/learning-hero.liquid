<section
  class="learning-hero"
  style="
    --learning-hero-ratio: {{ section.settings.aspect_ratio }};
    --learning-hero-background: {{ section.settings.fallback_color }};
  "
>
  <div class="learning-hero__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          widths: '375, 550, 750, 1100, 1500, 1600',
          sizes: '(min-width: 750px) 50vw, 100vw',
          loading: 'lazy',
          alt: section.settings.image.alt
      }}
    {% else %}
      {% render 'placeholder-image',
        aspect_ratio: section.settings.aspect_ratio,
        color: section.settings.fallback_color,
        label: section.settings.heading
      %}
    {% endif %}
  </div>

  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading | escape }}</h2>
  {% endif %}
</section>

{% stylesheet %}
  .learning-hero__media {
    aspect-ratio: var(--learning-hero-ratio, 16 / 9);
    background-color: var(--learning-hero-background);
    overflow: hidden;
  }

  .learning-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Learning hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Natural Self-Care, Done Right."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "16 / 9", "label": "Landscape (16:9)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "color",
      "id": "fallback_color",
      "label": "Fallback background colour",
      "default": "#d6f2ed"
    }
  ],
  "presets": [
    {
      "name": "Learning hero"
    }
  ]
}
{% endschema %}
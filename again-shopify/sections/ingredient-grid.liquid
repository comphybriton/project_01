<section class="again-ingredient-grid color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <header class="again-ingredient-grid__header">
        {% if section.settings.eyebrow != blank %}
          <p class="again-ingredient-grid__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="again-ingredient-grid__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}
      </header>
    {% endif %}

    <ul class="again-ingredient-grid__list" role="list">
      {% for block in section.blocks %}
        <li class="again-ingredient-card" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <span class="again-ingredient-card__icon-tile" aria-hidden="true">
              {{
                block.settings.icon
                | image_url: width: 96
                | image_tag:
                  widths: '48, 96',
                  sizes: '48px',
                  class: 'again-ingredient-card__icon',
                  loading: 'lazy',
                  alt: ''
              }}
            </span>
          {% endif %}

          <div class="again-ingredient-card__content">
            <div class="again-ingredient-card__heading">
              {% if block.settings.title != blank %}
                <h3 class="again-ingredient-card__title">
                  {{ block.settings.title | escape }}
                </h3>
              {% endif %}

              {% if block.settings.benefit != blank %}
                <span class="again-ingredient-card__benefit">
                  {{ block.settings.benefit | escape }}
                </span>
              {% endif %}
            </div>

            {% if block.settings.description != blank %}
              <div class="again-ingredient-card__description rte">
                {{ block.settings.description }}
              </div>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "AGAIN ingredient grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What's inside"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ingredients that work, every day."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Ingredient name",
          "default": "Coconut oil"
        },
        {
          "type": "text",
          "id": "benefit",
          "label": "Benefit label",
          "default": "Nourish"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Naturally conditioning and gentle on skin.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "AGAIN ingredient grid",
      "blocks": [{ "type": "ingredient" }, { "type": "ingredient" }, { "type": "ingredient" }]
    }
  ]
}
{% endschema %}

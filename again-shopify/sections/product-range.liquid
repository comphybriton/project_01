<section class="again-product-range color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <header class="again-product-range__header">
      {% if section.settings.eyebrow != blank %}
        <p class="again-product-range__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="again-product-range__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="again-product-range__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </header>

    <ul class="again-product-range__grid" role="list">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        {% if product != blank %}
          <li
            class="again-product-range__item again-product-range__item--{{ block.settings.media_tone }}"
            {{ block.shopify_attributes }}
          >
            <a
              class="again-product-card"
              href="{{ product.url }}"
              aria-label="Shop {{ product.title | escape }}"
            >
              {% if block.settings.badge != blank %}
                <span class="again-product-card__badge">
                  {{ block.settings.badge | escape }}
                </span>
              {% endif %}

              <div class="again-product-card__media">
                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 1000
                    | image_tag:
                      widths: '300, 500, 750, 1000',
                      sizes: '(min-width: 990px) 30vw, 90vw',
                      loading: 'lazy',
                      alt: product.featured_image.alt | default: product.title
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'again-product-card__placeholder' }}
                {% endif %}
              </div>

              <h3 class="again-product-card__title">
                {{ product.title | escape }}
              </h3>

              {% if block.settings.subtitle != blank %}
                <p class="again-product-card__subtitle">
                  {{ block.settings.subtitle | escape }}
                </p>
              {% endif %}

              <div class="again-product-card__footer">
                <span class="again-product-card__price">
                  {{ product.price | money }}
                </span>
                <span class="again-product-card__shop">Shop &rarr;</span>
              </div>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "AGAIN product range",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Two products. That's it."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Everything you need, nothing you don't.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Card description",
          "default": "Made for sensitive skin."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
        },
        {
          "type": "select",
          "id": "media_tone",
          "label": "Image area colour",
          "options": [
            { "value": "mint", "label": "Mint" },
            { "value": "sand", "label": "Sand" },
            { "value": "blue", "label": "Blue" }
          ],
          "default": "mint"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "AGAIN product range",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}